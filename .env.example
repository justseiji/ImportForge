# Local demo: copy to .env and choose a password before seeding.
APP_MODE=local
APP_ORIGIN=http://localhost:5173
PORT=3001
DEMO_PASSWORD=
# Production topology (APP_MODE=production)
DATABASE_URL=postgresql://importforge:change-me@localhost:5432/importforge
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=importforge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional provider; no requests until explicit consent
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
