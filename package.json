{
  "name": "importforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/main.ts\" \"vite --config apps/web/vite.config.ts\"",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "postinstall": "prisma generate",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.js *.json docs/*.md README.md",
    "demo": "tsx scripts/demo-data.ts",
    "maintenance": "tsx scripts/maintenance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@electric-sql/pglite": "^0.5.12",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.61.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
